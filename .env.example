# API configuration
VITE_API_URL=/api

# Chat assistant endpoint (must be backed by a server-side key)
VITE_LLM_API_URL=/api/llm
VITE_OPENAI_MODEL=gpt-4-turbo

# External services
VITE_UNIPROT_API_URL=https://rest.uniprot.org/uniprotkb
VITE_RCSB_API_URL=https://search.rcsb.org/rcsbsearch/v1
VITE_NCBI_API_URL=https://eutils.ncbi.nlm.nih.gov/entrez/eutils
VITE_PUBCHEM_API_URL=https://pubchem.ncbi.nlm.nih.gov/rest/pug

# Feature flags
VITE_ENABLE_3D_VIEWER=true
VITE_ENABLE_CHAT_ASSISTANT=true
VITE_ENABLE_BATCH_UPLOAD=false
VITE_ENABLE_ADVANCED_FEATURES=false

# Analytics
VITE_ANALYTICS_ID= 